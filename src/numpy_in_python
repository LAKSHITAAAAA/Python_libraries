"""**Chapter-5: Array Modifications**

**Modifications in an existing array**

We need to add,remove,stack or merge/split the array as the data stored in the array keeps evolivng with time.The size of array once made is fixed,so if we want to make any modifications,we need to make a new array for the same.
"""

#5.1: Adding an element,we function named insert for it.
"""Syntax: np.insert(array,index,value,axis)
array: original array that need to be modified.
index: the index at which we want to insert that element.
value: the specific value to be inserted.
axis: If none,it is inserted in a flat array of 1-D.
whereas for 2d,if axis=0,row-wise else axis=1,column-wise."""
import numpy as np
#insert in 1-d

arr=np.array([10,20,30,40,50])
print(arr)
new_arr=np.insert(arr,2,100,axis=0)
print(new_arr)

#insert in 2-d
arr_2d=np.array([[10,20,30],[40,50,60]])
print(arr_2d)
new_arr_2d=np.insert(arr_2d,1,[6,7,8],axis=0)
print(new_arr_2d)

# append function,adding an element to the end.
arr=np.array([10,20,30])
new_arr=np.append(arr,[40,50,60,70])
print(new_arr)

#Concatination
"""Syntax: np.concatenate((array1,array2),axis=0)
axis=0: vertical stacking
axis=1: horizontal stacking
"""
arr1=np.array([1,2,3])
arr2=np.array([4,5,6])

new_arr=np.concatenate((arr1,arr2),axis=0)
print(new_arr)

#5.2 Removing elements of array,using delete functon.
"""Syntax: np.delete(array,index,axis)
array: on which we need to perform operations
index: element at that index will be deleted
axis: If none working on flat array"""
import numpy as np
#1-d deletion
arr=np.array([10,20,30,40,50])
new_arr=np.delete(arr,2,axis=0)
print(new_arr)
#2-d deletion
arr_2d=np.array([[1,2,3],[4,5,6]])
new_arr_2d=np.delete(arr_2d,1,axis=0) #removing 2 row of array
