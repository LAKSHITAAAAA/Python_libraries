"""**Chapter-7: Handling Missing Values**

Missing values can influence the result we want in a negative way.So,we need to handle them.

**How Python can help us in handling missing values?**

It has 3 buit-in functions for the same.
1. np.isnan(): Detect missing values.
2. np.nan_to_num(): Replacing nan with a specified number.
3. np.isinf(): Used to find infinte values in a any column or row.
NaN: not a number.

"""

# examples
"""1. np.isnan():
Detect missing values.
2. np.nan_to_num():
Replacing nan with a specified number.
3. np.isinf():
Used to find infinte values in a any column or row."""

import numpy as np
""" 1.Syntax for isnan():np.isnan(array)"""
arr=np.array([1,2,3,np.nan,5,6,7,np.nan])
print(np.isnan(arr))
""" NaN values can never be compared with each other.
np.nan()==np.nan() will return false."""

"""2.Syntax for nan_to_num():
np.nan_to_num(array,nan=value that we need at place of nan )
Defualt number is zero."""
arr=np.array([1,2,3,np.nan,5,6,7,np.nan])
print(np.nan_to_num(arr,nan=1))

"""3.Syntax for isinf():
np.isinf(array)"""
arr=np.array([1,2,3,np.inf,5,6,7,np.inf,-np.inf])
print(np.isinf(arr))

#Replacing finite number with infinite number.
cleaned_arr=np.nan_to_num(arr,posinf=1000, neginf=-1000)
print(cleaned_arr)

